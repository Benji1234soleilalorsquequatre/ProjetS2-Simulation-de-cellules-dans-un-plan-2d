<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="450.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.Controller">

   <top>
      <Button fx:id="startButton" onAction="#startSimulation" text="Start" BorderPane.alignment="CENTER" />
   </top>
   <bottom>
      <Button fx:id="canadairButton" text="Canadair" onAction="#activateCanadair"/>
   </bottom>
   <center>
      <Canvas fx:id="canvas" height="800.0" width="800.0" BorderPane.alignment="CENTER" />
   </center>
   <right>
      <VBox spacing="5" BorderPane.alignment="CENTER">
         <Label fx:id="stateLabel" />
         <Label fx:id="humidityLabel" />
         <Label fx:id="heatLabel" />
         <Label fx:id="fuelLabel" />
         <Label text="=== Configuration ===" style="-fx-font-weight: bold;-fx-padding-top: 15;"/>
         <Label text="Humidité Min :" />
         <javafx.scene.control.TextField fx:id="inputMinHumidity" text="10" prefWidth="80.0"/>

         <Label text="Humidité Max :" />
         <javafx.scene.control.TextField fx:id="inputMaxHumidity" text="50" prefWidth="80.0"/>
         
         <Label text="Combustible Min :" />
         <javafx.scene.control.TextField fx:id="inputMinFuel" text="50" prefWidth="80.0"/>

         <Label text="Combustible Max :" />
         <javafx.scene.control.TextField fx:id="inputMaxFuel" text="50" prefWidth="80.0"/>
         
         <Button text="Relancer la Simu" onAction="#handleResetSimulation" style="-fx-background-color: #19ad0b; -fx-text-fill: white;-fx-font-weight: bold;"/>
      </VBox>
   </right>

</BorderPane>
